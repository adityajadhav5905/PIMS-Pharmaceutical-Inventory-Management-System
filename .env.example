# ─── Express Server ──────────────────────────────────────────────────────────
SERVER_PORT=5000

# ─── MongoDB Database ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/pims

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── ML Microservice ──────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ─── Client / CORS ────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development

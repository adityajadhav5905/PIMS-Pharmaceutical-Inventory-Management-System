# ─── Express Server (Render / Cloud Backend) ──────────────────────────────
SERVER_PORT=5000
# PORT is automatically injected by Render/Heroku if SERVER_PORT is not set

# ─── MongoDB Database ─────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pims?retryWrites=true&w=majority

# ─── JWT Authentication (Required in Production) ──────────────────────────────
# Generate 64-character hex strings: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── ML Microservice URL (FastAPI on Render) ──────────────────────────────────
# Local dev: http://localhost:8000 | Production: https://<ml-service-name>.onrender.com
ML_SERVICE_URL=http://localhost:8000

# ─── Client / CORS (Vercel Frontend URL) ──────────────────────────────────────
# Comma-separated allowed origins (e.g. https://pims-client.vercel.app,http://localhost:5173)
CLIENT_URL=http://localhost:5173

# ─── Frontend Environment (Vercel Build Environment Variables) ────────────────
# Set in Vercel project dashboard to point to deployed Render backend:
# VITE_API_URL=https://<backend-service-name>.onrender.com

# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=development
